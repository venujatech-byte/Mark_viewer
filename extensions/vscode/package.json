{
  "name": "mark-reader",
  "displayName": "Mark — Markdown Reader",
  "description": "Read rendered markdown and safely edit its source.",
  "publisher": "mark-reader",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node scripts/assets.mjs && tsc -p .",
    "lint": "tsc -p . --noEmit",
    "test": "node --test tests/*.test.cjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/vscode": "1.144.0",
    "@vscode/vsce": "4.1.1",
    "typescript": "7.0.2"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "mark.reader",
        "displayName": "Mark Markdown",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          },
          {
            "filenamePattern": "*.mdown"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "mark.openDocument",
        "title": "Mark: Open Markdown File"
      },
      {
        "command": "mark.toggleEdit",
        "title": "Mark: Toggle Source Editing"
      }
    ],
    "keybindings": [
      {
        "command": "mark.openDocument",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o"
      },
      {
        "command": "mark.toggleEdit",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "activeCustomEditorId == mark.reader"
      }
    ]
  },
  "icon": "media/icon.png",
  "activationEvents": [
    "onCustomEditor:mark.reader",
    "onCommand:mark.openDocument",
    "onCommand:mark.toggleEdit"
  ]
}
